generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  product   String?
  quantity  String?
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  budget    String?
  category  String?
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String
  image       String?
  category    String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
