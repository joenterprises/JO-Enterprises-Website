# Production PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Protect the /admin lightweight CRM.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-long-random-password"

# Optional: only needed if you later enable server-side WhatsApp Cloud API.
# The current quote flow uses the visitor's WhatsApp app and does not require these.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_GRAPH_VERSION="v23.0"
